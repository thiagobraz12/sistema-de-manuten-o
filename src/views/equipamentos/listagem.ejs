<div class="container-fluid">

  <div class="d-sm-flex align-items-center justify-content-between mb-4">


<h1 class="h3 mb-0 text-gray-800">
  Equipamentos
</h1>

<a
  href="/equipamentos/novo"
  class="btn btn-primary shadow-sm"
>

  <i class="fas fa-plus mr-1"></i>

  Novo Equipamento

</a>


  </div>

  <div class="card shadow mb-4">


<div class="card-body">

  <div class="table-responsive">

    <table
      class="table table-bordered table-hover"
      width="100%"
      cellspacing="0"
    >

      <thead class="bg-primary text-white">

        <tr>

          <th>Nome</th>

          <th>Patrimônio</th>

          <th>Marca</th>

          <th>Modelo</th>

          <th>Localização</th>

          <th>Status</th>

          <th width="120">
            Ações
          </th>

        </tr>

      </thead>

      <tbody>

        <% equipamentos.forEach((equipamento) => { %>

          <tr>

            <td><%= equipamento.nome %></td>

            <td><%= equipamento.patrimonio %></td>

            <td><%= equipamento.marca || '-' %></td>

            <td><%= equipamento.modelo || '-' %></td>

            <td><%= equipamento.localizacao || '-' %></td>

            <td>

              <% if (equipamento.status === 'Ativo') { %>

                <span class="badge badge-success">
                  Ativo
                </span>

              <% } else { %>

                <span class="badge badge-danger">
                  Inativo
                </span>

              <% } %>

            </td>

            <td class="text-center">

              <a
                href="/equipamentos/editar/<%= equipamento.id %>"
                class="btn btn-sm btn-primary"
              >

                <i class="fas fa-pen"></i>

              </a>

              <form
                action="/equipamentos/excluir/<%= equipamento.id %>"
                method="POST"
                class="d-inline form-excluir"
              >

                <button
                  type="submit"
                  class="btn btn-sm btn-danger"
                >

                  <i class="fas fa-trash"></i>

                </button>

              </form>

            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

</div>


  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

const formsExcluir =
  document.querySelectorAll('.form-excluir');

formsExcluir.forEach((form) => {

  form.addEventListener('submit', function(e) {

    e.preventDefault();

    Swal.fire({

      title: 'Deseja excluir?',

      text: 'Essa ação não poderá ser desfeita.',

      icon: 'warning',

      showCancelButton: true,

      confirmButtonColor: '#d33',

      cancelButtonColor: '#6c757d',

      confirmButtonText: 'Sim, excluir',

      cancelButtonText: 'Cancelar',

    }).then((result) => {

      if (result.isConfirmed) {

        form.submit();

      }

    });

  });

});

</script>

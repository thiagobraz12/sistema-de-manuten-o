<%
const emailValue = typeof email !== 'undefined' ? email : '';

const emailErro =
  typeof emailError !== 'undefined'
    ? emailError
    : '';

const senhaErro =
  typeof senhaError !== 'undefined'
    ? senhaError
    : '';

const loginErro =
  typeof loginError !== 'undefined'
    ? loginError
    : '';

const successLogin =
  typeof success !== 'undefined'
    ? success
    : false;
%>

<style>

body {
  background: linear-gradient(
    135deg,
    #4e73df,
    #224abe
  );
}

.login-container {

  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

}

.login-card {

  width: 100%;
  max-width: 500px;

  border: none;
  border-radius: 18px;

  overflow: hidden;

}

.login-body {

  padding: 50px;

}

.login-title-icon {

  font-size: 60px;
  color: #4e73df;

  margin-bottom: 20px;

}

.form-control-user {

  height: 55px;

  border-radius: 50px;

}

.btn-user {

  height: 55px;

  border-radius: 50px;

  font-size: 16px;
  font-weight: 600;

}

.field-error {

  font-size: 13px;

  margin-top: 6px;
  margin-left: 10px;

  color: #e74a3b;

}

.input-error {

  border: 2px solid #e74a3b !important;

}

</style>

<div class="login-container">

  <div class="card shadow-lg login-card">

    <div class="card-body login-body">

      <!-- ÍCONE -->
      <div class="text-center">

        <div class="login-title-icon">
          <i class="fas fa-tools"></i>
        </div>

        <h1 class="h3 text-gray-900 mb-2">
          Sistema de Manutenção
        </h1>

        <p class="text-muted mb-4">
          Faça login para continuar
        </p>

      </div>

      <!-- FORM -->
      <form
        class="user"
        method="POST"
        action="/login"
        novalidate
      >

        <!-- EMAIL -->
        <div class="form-group">

          <input
            type="text"
            name="email"
            class="form-control form-control-user <%= emailErro ? 'input-error' : '' %>"
            placeholder="E-mail"
            value="<%= emailValue %>"
            required
          >

          <% if(emailErro){ %>

            <div class="field-error">

              <i class="fas fa-exclamation-circle"></i>

              <%= emailErro %>

            </div>

          <% } %>

        </div>

        <!-- SENHA -->
        <div class="form-group">

          <input
            type="password"
            name="senha"
            class="form-control form-control-user <%= senhaErro ? 'input-error' : '' %>"
            placeholder="Digite sua senha"
            minlength="4"
            required
          >

          <% if(senhaErro){ %>

            <div class="field-error">

              <i class="fas fa-exclamation-circle"></i>

              <%= senhaErro %>

            </div>

          <% } %>

        </div>

        <!-- LOGIN INVÁLIDO -->
        <% if(loginErro){ %>

          <div class="alert alert-danger text-center">

            <%= loginErro %>

          </div>

        <% } %>

        <!-- BOTÃO -->
        <button
          type="submit"
          class="btn btn-primary btn-user btn-block"
        >

          <i class="fas fa-sign-in-alt"></i>

          Entrar

        </button>

      </form>

    </div>

  </div>

</div>

<script>

window.onload = function () {

  var success = "<%= successLogin %>";

  if (success === "true") {

    window.location.href = "/dashboard";

  }

};

</script>
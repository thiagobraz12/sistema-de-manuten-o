<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Impressão</title>

<link href="/css/sb-admin-2.min.css" rel="stylesheet">
<link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">

<style>

body {
  background: #f8f9fc;
}

.container-print {
  max-width: 800px;
  margin: 40px auto;
}

.card-print {
  border-left: 5px solid #4e73df;
}

/* DATA */
.data {
  font-size: 14px;
  color: #858796;
}

.label {
  font-weight: 600;
  color: #5a5c69;
  margin-right: 5px;
}

.valor {
  font-size: 16px;
  color: #2e2e2e;
  white-space: nowrap;
}

@media print {

  .no-print {
    display: none;
  }

  body {
    background: white;
  }

}

</style>

</head>

<body>

<div class="container-print">

  <!-- DATA NO TOPO -->
  <div class="d-flex justify-content-end mb-2 data">
    Data: <span id="dataAtual" class="ml-1"></span>
  </div>

  <div class="card shadow mb-4 card-print">

    <div class="card-header py-3 d-flex justify-content-between align-items-center">

      <h6 class="m-0 font-weight-bold text-primary">
        Solicitação de Manutenção
      </h6>

      <button onclick="window.print()" class="btn btn-primary btn-sm no-print">
        <i class="fas fa-print"></i> Imprimir
      </button>

    </div>

    <div class="card-body">

      <!-- TIPO + STATUS -->
      <div class="row mb-3">

        <div class="col-md-6">

          <div class="valor">

            <span class="label">Tipo:</span>

            <%= manutencao.tipo %>

          </div>

        </div>

        <div class="col-md-6">

          <div class="valor">

            <span class="label">Status:</span>

            <span class="badge
              <%= manutencao.status === 'aberto' ? 'badge-warning' : '' %>
              <%= manutencao.status === 'em andamento' ? 'badge-info' : '' %>
              <%= manutencao.status === 'concluído' ? 'badge-success' : '' %>
              <%= manutencao.status === 'em análise' ? 'badge-dark' : '' %>
              <%= manutencao.status === 'cancelado' ? 'badge-danger' : '' %>
            ">
              <%= manutencao.status %>
            </span>

          </div>

        </div>

      </div>

      <!-- LOCAL + PRIORIDADE -->
      <div class="row mb-3">

        <div class="col-md-6">

          <div class="valor">

            <span class="label">Local:</span>

            <%= manutencao.local %>

          </div>

        </div>

        <div class="col-md-6">

          <div class="valor">

            <span class="label">Prioridade:</span>

            <span class="badge
              <%= manutencao.prioridade?.nome === 'Alta' ? 'badge-danger' : '' %>
              <%= manutencao.prioridade?.nome === 'Média' ? 'badge-warning' : '' %>
              <%= manutencao.prioridade?.nome === 'Baixa' ? 'badge-secondary' : '' %>
            ">
              <%= manutencao.prioridade?.nome %>
            </span>

          </div>

        </div>

      </div>

       <!-- FORNECEDOR -->

         <div class="row mb-3">

         <div class="col-md-6">

         <span class="label">Fornecedor:</span>

         <% if (manutencao.fornecedor) { %>

            <span>
            <%= manutencao.fornecedor.empresa %>
            </span>

          <% } else { %>

           <span class="text-muted">
              Não informado
           </span>

          <% } %>

         </div>

      </div>

      <!-- MANUTENÇÃO PREVENTIVA -->

<% if (manutencao.preventiva) { %>

<div class="row mb-3">

  <div class="col-md-4">

    <div class="valor">

      <span class="label">Tipo:</span>

      <span class="badge badge-success">

        <i class="fas fa-check-circle"></i>

        Preventiva

      </span>

    </div>

  </div>

  <div class="col-md-4">

    <div class="valor">

      <span class="label">Periodicidade:</span>

      <%= manutencao.periodicidade || '-' %>

    </div>

  </div>

  <div class="col-md-4">

    <div class="valor">

      <span class="label">Próxima Execução:</span>

      <%= manutencao.proximaExecucao
        ? new Date(manutencao.proximaExecucao).toLocaleDateString('pt-BR')
        : '-' %>

    </div>

  </div>

</div>

<% } %>

      <!-- RESPONSÁVEL + VALOR -->
      <div class="row mb-3">

        <div class="col-md-6">

          <div class="valor">

            <span class="label">Responsável:</span>

            <%= manutencao.responsavel || 'Não informado' %>

          </div>

        </div>

        <div class="col-md-6">

          <div class="valor">

            <span class="label">Valor:</span>

            R$
            <%= Number(manutencao.valor || 0).toLocaleString('pt-BR', {
              minimumFractionDigits: 2
            }) %>

          </div>

        </div>

      </div>

      <!-- DATA DE CONCLUSÃO -->
      <div class="row mb-3">

        <div class="col-md-12">

          <div class="valor">

            <span class="label">Concluído em:</span>

            <%= manutencao.dataConclusao
              ? new Date(manutencao.dataConclusao).toLocaleDateString('pt-BR')
              : 'Não concluído'
            %>

          </div>

        </div>

      </div>

      <!-- DESCRIÇÃO -->
      <div class="row">

        <div class="col-12">

          <div class="valor">

            <span class="label">Descrição:</span>

            <%= manutencao.descricao %>

          </div>

        </div>

      </div>

    </div>

  </div>
  <hr class="my-4">

<h5 class="font-weight-bold text-primary mb-3">
    Histórico
</h5>

<% if (historico && historico.length > 0) { %>

<table class="table table-bordered">

    <thead class="thead-light">

        <tr>

            <th>Status</th>

            <th>Data</th>

        </tr>

    </thead>

    <tbody>

        <% historico.forEach(item => { %>

            <tr>

                <td>
                    <%= item.status %>
                </td>

                <td>

                    <%= new Date(item.data).toLocaleString('pt-BR') %>

                </td>

            </tr>

        <% }) %>

    </tbody>

</table>

<% } else { %>

<p class="text-muted">
    Nenhum histórico encontrado.
</p>

<% } %>



</div>
<hr class="my-4">

<h5 class="font-weight-bold text-primary mb-3">
    Fotos da Manutenção
</h5>

<% if (manutencao.fotos && manutencao.fotos.length > 0) { %>

<div class="row">

    <% manutencao.fotos.forEach(foto => { %>

        <div class="col-4 text-center mb-3">
            <img
                src="/uploads/<%= foto.nomeArquivo %>"
                class="img-fluid img-thumbnail"
                style="max-height:220px;"
            >

        </div>

    <% }) %>

</div>

<% } else { %>

<p class="text-muted">
    Nenhuma foto cadastrada.
</p>

<% } %>

<!-- SCRIPT DATA AUTOMÁTICA -->
<script>

const data = new Date();

const dataFormatada = data.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});

document.getElementById('dataAtual').innerText = dataFormatada;

</script>

</body>
</html>
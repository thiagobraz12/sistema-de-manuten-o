<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 text-gray-800">
            Histórico da Solicitação
        </h1>

        <a href="/manutencoes" class="btn btn-primary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i>
            Voltar
        </a>
    </div>

    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <%= manutencao.descricao %>
            </h6>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Descrição:</strong><br>
                    <%= manutencao.descricao %>
                </div>

                <% if (manutencao.equipamento) { %>
                    <div class="col-md-6 mb-3">
                        <strong>Equipamento:</strong><br>
                        <%= manutencao.equipamento.nome %>
                    </div>
                <% } %>

                <% if (manutencao.fornecedor) { %>
                    <div class="col-md-6 mb-3">
                        <strong>Fornecedor:</strong><br>
                        <%= manutencao.fornecedor.empresa %>
                    </div>
                <% } %>

                <% if (manutencao.prioridade) { %>
                    <div class="col-md-6 mb-3">
                        <strong>Prioridade:</strong><br>
                        <%= manutencao.prioridade.nome %>
                    </div>
                <% } %>

            </div>

            <% if (manutencao.fotos && manutencao.fotos.length > 0) { %>

                <hr>

                <h5 class="font-weight-bold text-primary mb-3">
                    Fotos da Manutenção
                </h5>

                <div class="row">

                    <% manutencao.fotos.forEach(foto => { %>

                        <div class="col-md-4 mb-4">

                            <img
                                 src="/uploads/<%= foto.nomeArquivo %>"
                                 class="img-fluid rounded shadow border"
                                 style="max-width:350px; max-height:200px; object-fit:cover;"
                                 alt="Foto da manutenção">

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <div class="alert alert-warning">
                    Nenhuma foto cadastrada.
                </div>

            <% } %>

            <hr>

            <h5 class="font-weight-bold text-primary mb-3">
                Histórico
            </h5>

            <% if (historico && historico.length > 0) { %>

                <div class="table-responsive">

                    <table class="table table-hover table-bordered">

                        <thead class="thead-light">

                            <tr>
                                <th>Status</th>
                                <th>Data</th>
                            </tr>

                        </thead>

                        <tbody>

                            <% historico.forEach(item => { %>

                                <tr>

                                    <td>

                                        <% if(item.status === 'Aberta'){ %>

                                            <span class="badge badge-warning">
                                                <%= item.status %>
                                            </span>

                                        <% } else if(item.status === 'Em andamento'){ %>

                                            <span class="badge badge-info">
                                                <%= item.status %>
                                            </span>

                                        <% } else if(item.status === 'Concluída'){ %>

                                            <span class="badge badge-success">
                                                <%= item.status %>
                                            </span>

                                        <% } else if(item.status === 'Cancelada'){ %>

                                            <span class="badge badge-danger">
                                                <%= item.status %>
                                            </span>

                                        <% } else { %>

                                            <span class="badge badge-secondary">
                                                <%= item.status %>
                                            </span>

                                        <% } %>

                                    </td>

                                    <td>
                                        <%= new Date(item.data).toLocaleString('pt-BR') %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="alert alert-info mb-0">
                    Nenhum histórico encontrado.
                </div>

            <% } %>

        </div>

    </div>

</div>
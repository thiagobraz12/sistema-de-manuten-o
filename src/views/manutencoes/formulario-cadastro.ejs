<div class="container-fluid">

  <div class="row justify-content-center">

    <div class="col-lg-12">

      <div class="card shadow mb-4">

        <div class="card-header bg-primary text-white">

          <h6 class="m-0 font-weight-bold">
            <i class="fas fa-tools mr-2"></i>
            Nova Solicitação de Manutenção
          </h6>

        </div>

        <div class="card-body">

          <form action="/manutencoes/criar" method="POST" enctype="multipart/form-data">
            

            <input
              type="hidden"
              name="status"
              value="aberto"
            />

           <div class="row">

         <!-- COLUNA ESQUERDA -->

           <div class="col-md-6">

        <!-- TIPO -->
         <div class="form-group">

         <label>Tipo de manutenção</label>

         <select
         name="tipo"
         class="form-control <%= erros?.tipo ? 'is-invalid' : '' %>"
        >

    <option value="">
      Selecione
    </option>

    <option value="elétrica" <%= dados?.tipo === 'elétrica' ? 'selected' : '' %>>
      Elétrica
    </option>

    <option value="hidráulica" <%= dados?.tipo === 'hidráulica' ? 'selected' : '' %>>
      Hidráulica
    </option>

    <option value="geral" <%= dados?.tipo === 'geral' ? 'selected' : '' %>>
      Geral
    </option>

    <option value="civil" <%= dados?.tipo === 'civil' ? 'selected' : '' %>>
      Civil
    </option>

    <option value="climatização" <%= dados?.tipo === 'climatização' ? 'selected' : '' %>>
      Climatização
    </option>

    <option value="segurança" <%= dados?.tipo === 'segurança' ? 'selected' : '' %>>
      Segurança
    </option>
    

  </select>

  <% if(erros?.tipo){ %>
  <div class="invalid-feedback d-block">
    <%= erros.tipo %>
  </div>
  <% } %>

</div>

<!-- LOCAL -->
<div class="form-group">

  <label>Local</label>

  <input
    type="text"
    name="local"
    class="form-control <%= erros?.local ? 'is-invalid' : '' %>"
    value="<%= dados?.local || '' %>"
    placeholder="Ex: Bloco A - Sala 02"
  >

  <% if(erros?.local){ %>
  <div class="invalid-feedback d-block">
    <%= erros.local %>
  </div>
  <% } %>

</div>

<!-- DESCRIÇÃO -->
<div class="form-group">

  <label>Descrição</label>

  <input
    type="text"
    name="descricao"
    class="form-control <%= erros?.descricao ? 'is-invalid' : '' %>"
    value="<%= dados?.descricao || '' %>"
  >

  <% if(erros?.descricao){ %>
  <div class="invalid-feedback d-block">
    <%= erros.descricao %>
  </div>
  <% } %>

</div>

<!-- RESPONSÁVEL -->
<div class="form-group">

  <label>Responsável</label>

  <input
    type="text"
    name="responsavel"
    class="form-control <%= erros?.responsavel ? 'is-invalid' : '' %>"
    value="<%= dados?.responsavel || '' %>"
    placeholder="Ex: João Silva"
  >

  <% if(erros?.responsavel){ %>
  <div class="invalid-feedback d-block">
    <%= erros.responsavel %>
  </div>
  <% } %>

</div>

  </div>

  <!-- COLUNA DIREITA -->

  <div class="col-md-6">

<!-- VALOR -->
<div class="form-group">

  <label>Valor da manutenção</label>

  <input
    type="number"
    step="0.01"
    name="valor"
    class="form-control <%= erros?.valor ? 'is-invalid' : '' %>"
    value="<%= dados?.valor || '' %>"
    placeholder="0.00"
  >

  <% if(erros?.valor){ %>
  <div class="invalid-feedback d-block">
    <%= erros.valor %>
  </div>
  <% } %>

</div>

<!-- PRIORIDADE -->
<div class="form-group">

  <label>Prioridade</label>

  <select
    name="prioridadeId"
    class="form-control <%= erros?.prioridadeId ? 'is-invalid' : '' %>"
  >

    <option value="">
      Selecione
    </option>

    <% prioridades.forEach(p => { %>

    <option
      value="<%= p.id %>"
      <%= dados?.prioridadeId == p.id ? 'selected' : '' %>
    >

      <%= p.nome %>

    </option>

    <% }) %>

  </select>

  <% if(erros?.prioridadeId){ %>
  <div class="invalid-feedback d-block">
    <%= erros.prioridadeId %>
  </div>
  <% } %>

</div>

            <!-- FORNECEDOR -->

<div class="form-group">

<label>Fornecedor</label>

<select
name="fornecedorId"
class="form-control <%= erros?.fornecedorId ? 'is-invalid' : '' %>"

>

<option value="">
  Selecione um fornecedor
</option>

<% fornecedores.forEach(f => { %>

<option
  value="<%= f.id %>"
  <%= dados?.fornecedorId == f.id ? 'selected' : '' %>
>

  <%= f.empresa %>

</option>

<% }) %>

  </select>

<% if(erros?.fornecedorId){ %>

  <div class="invalid-feedback d-block">
    <%= erros.fornecedorId %>
  </div>

<% } %>

</div>

<!-- EQUIPAMENTO -->

<div class="form-group">

  <label>Equipamento</label>

  <select
    name="equipamentoId"
    class="form-control <%= erros?.equipamentoId ? 'is-invalid' : '' %>"
  >

    <option value="">
      Selecione um equipamento
    </option>

    <% equipamentos.forEach((equipamento) => { %>

      <option
        value="<%= equipamento.id %>"
         <%= dados?.equipamentoId == equipamento.id ? 'selected' : '' %>
        >
        <%= equipamento.nome %>
      </option>

    <% }) %>

  </select>

  <% if(erros?.equipamentoId){ %>
  <div class="invalid-feedback d-block">
    <%= erros.equipamentoId %>
  </div>
  <% } %>

</div>

<div class="form-group">

  <label>Foto</label>

  <input
    type="file"
    name="foto"
    class="form-control"
    accept="image/*"
  >

</div>

</div> <!-- FECHA COLUNA DIREITA -->

</div> <!-- FECHA ROW DAS DUAS COLUNAS -->

<hr>

  <!-- MANUTENÇÃO PREVENTIVA -->

 <div class="card border-left-success shadow-sm mb-4">

  <div class="card-header bg-success text-white">

 <strong>
  Manutenção Preventiva
 </strong>

  </div>

  <div class="card-body">

<div class="row">

  <div class="col-md-4">

    <div class="form-group">

      <label>

        <input
          type="checkbox"
          name="preventiva"
          value="true"
          <%= dados?.preventiva ? 'checked' : '' %>
        >

        Esta manutenção é preventiva

      </label>

    </div>

  </div>

  <div class="col-md-4">

    <div class="form-group">

      <label>Periodicidade</label>

      <select
        name="periodicidade"
        class="form-control <%= erros?.periodicidade ? 'is-invalid' : '' %>"
      >

        <option value="">
          Selecione
        </option>

        <option
          value="mensal"
          <%= dados?.periodicidade === 'mensal' ? 'selected' : '' %>
        >
          Mensal
        </option>

        <option
          value="trimestral"
          <%= dados?.periodicidade === 'trimestral' ? 'selected' : '' %>
        >
          Trimestral
        </option>

        <option
          value="semestral"
          <%= dados?.periodicidade === 'semestral' ? 'selected' : '' %>
        >
          Semestral
        </option>

        <option
          value="anual"
          <%= dados?.periodicidade === 'anual' ? 'selected' : '' %>
        >
          Anual
        </option>

      </select>

      <% if(erros?.periodicidade){ %>

      <div class="invalid-feedback d-block">
        <%= erros.periodicidade %>
      </div>

      <% } %>

    </div>

  </div>

  <div class="col-md-4">

    <div class="form-group">

      <label>Próxima execução</label>

      <input
        type="date"
        name="proximaExecucao"
        value="<%= dados?.proximaExecucao || '' %>"
        class="form-control <%= erros?.proximaExecucao ? 'is-invalid' : '' %>"
      >

      <% if(erros?.proximaExecucao){ %>

      <div class="invalid-feedback d-block">
        <%= erros.proximaExecucao %>
      </div>

      <% } %>

    </div>

  </div>

</div>

  </div>

</div>

<!-- BOTÕES -->

<div class="border-top pt-4 mt-4">

  <div class="d-flex justify-content-end">

<a
  href="/manutencoes"
  class="btn btn-secondary mr-2"
>
  Cancelar
</a>

<button
  type="submit"
  class="btn btn-primary"
>
  <i class="fas fa-save"></i>
  Salvar
</button>

  </div>

</div>

</form>

</div>

</div>

</div>

</div>

</div>


